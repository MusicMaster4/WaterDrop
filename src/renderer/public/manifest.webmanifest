{
  "name": "WaterDrop",
  "short_name": "WaterDrop",
  "description": "Private file shelf for trusted Tailscale devices.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#08080a",
  "theme_color": "#08080a",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/*",
            "application/octet-stream",
            ".7z",
            ".csv",
            ".gz",
            ".json",
            ".md",
            ".rar",
            ".tar",
            ".xml",
            ".zip"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "./icon.ico",
      "sizes": "16x16 24x24 32x32 48x48 64x64 128x128 256x256",
      "type": "image/x-icon"
    }
  ]
}
